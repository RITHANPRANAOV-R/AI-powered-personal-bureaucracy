# Local Ollama runtime (no API key required)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=90

# User Context & Profile Agent (separate model for document fact extraction)
PROFILE_MODEL=qwen3:4b-instruct
PROFILE_FALLBACK_MODEL=qwen3:1.7b
PROFILE_NUM_CTX=8192
PROFILE_TIMEOUT_SECONDS=120
VAULT_DIR=data/vault
PROFILE_PATH=data/profile.json

# Information Retrieval Agent
RETRIEVAL_EMBED_MODEL=qwen3-embedding:0.6b
RETRIEVAL_EXTRACT_MODEL=qwen3:1.7b
RETRIEVAL_TIMEOUT_SECONDS=20
RETRIEVAL_MAX_SOURCES=6
RETRIEVAL_CACHE_DIR=data/retrieval_cache
RETRIEVAL_USE_LLM=true

# Workflow Planning Agent (sequencing over structured facts/evidence; sequential model use)
PLANNING_MODEL=qwen3:4b-instruct
PLANNING_FALLBACK_MODEL=qwen3:1.7b
PLANNING_NUM_CTX=8192
PLANNING_TIMEOUT_SECONDS=120
